APP_NAME=LostCards
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lostcards
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lostcards.ci"
MAIL_FROM_NAME="LostCards Abidjan"

FRONTEND_URL=http://localhost:3000

# Seeder : mots de passe des comptes provisionnés (aucun défaut en dur).
# Si vide, le compte correspondant n'est pas créé par `php artisan db:seed`.
# Le compte démo n'est jamais créé en production.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
